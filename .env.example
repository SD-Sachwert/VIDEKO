# VIDEKO – Umgebungsvariablen (Vorlage)
#
# ECHTE Werte gehören NICHT hierher und werden NICHT committet.
# Sie liegen verschlüsselt auf Vercel. Hol sie dir mit:
#
#     npx vercel link        # einmalig: Projekt "videko" verknüpfen
#     npx vercel env pull .env.local
#
# (Dafür brauchst du Zugriff auf das Vercel-Projekt.)
# Diese Datei dokumentiert nur, WELCHE Variablen es gibt.
#
# Ausführliche Erklärung: docs/environment-setup.md
#
# Variablen mit VITE_ Prefix landen im Browser-Bundle und sind damit
# öffentlich sichtbar. Dort gehören ausschließlich Werte hinein, die
# öffentlich sein dürfen. Alles andere bleibt serverseitig.


# ─────────────────────────────────────────────────────────────
#  AKTIV GENUTZT
# ─────────────────────────────────────────────────────────────

# ── Strato-SMTP: Mailversand der Formulare (Server / api/lead.js) ──
# Ohne diese Werte laufen Beratungs- und Karriereformular NICHT.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@videko-kuechen.de
SMTP_PASS=__strato_postfach_passwort__
LEAD_NOTIFY_TO=info@videko-kuechen.de

# ── Supabase Server: Lead-Speicherung + Storage (api/lead.js) ──
SUPABASE_URL=https://tshdfkmpkcpkeufplzda.supabase.co
SUPABASE_SERVICE_KEY=__supabase_service_role_key__

# ── Supabase Client: Datei-Uploads im Stylefinder (public-safe) ──
VITE_SUPABASE_URL=https://tshdfkmpkcpkeufplzda.supabase.co
VITE_SUPABASE_ANON_KEY=__supabase_anon_key__


# ─────────────────────────────────────────────────────────────
#  MERCH-SHOP – VORBEREITET, NOCH NICHT VERDRAHTET
#
#  Der Shop läuft derzeit ohne Backend: Die Bestellung erzeugt eine
#  vorausgefüllte E-Mail, "Benachrichtige mich" ebenfalls. Beides
#  braucht keine Umgebungsvariablen. Die folgenden Werte sind für den
#  Ausbau vorgesehen; solange sie fehlen, bleibt der Mail-Weg aktiv.
# ─────────────────────────────────────────────────────────────

# ── Bestell- und Benachrichtigungsadresse des Shops ──
# Fallback sind die Werte aus src/data/shop-config.json.
VITE_SHOP_ORDER_MAIL=shop@videko-kuechen.de
VITE_SHOP_NOTIFY_MAIL=shop@videko-kuechen.de

# ── Coming-Soon-Benachrichtigungen (api/notify.js) ──
# Der "Benachrichtige mich"-Endpoint ist umgesetzt. Er nutzt DIESELBEN
# SMTP_*- und SUPABASE_*-Werte wie api/lead.js (siehe oben). Sind sie gesetzt,
# speichert er die Vormerkung in der Supabase-Tabelle `videko_notify` und
# schickt Bestätigungsmails. Sind sie NICHT gesetzt, meldet der Endpoint
# ehrlich `configured:false` – die UI zeigt dann "noch nicht angebunden" statt
# eines gefälschten Erfolgs.
# Zieladresse für die interne Vormerk-Mail (Fallback: info@videko-kuechen.de):
NOTIFY_TO=shop@videko-kuechen.de
# Anzulegende Tabelle: videko_notify (Spalten: email, product_id, product_name, variant, meta jsonb, created_at)

# ── Checkout / Payment ──
# Sobald ein echter Checkout kommt, hier den Anbieter hinterlegen.
# Der öffentliche Key darf ins Bundle, der Secret Key NIEMALS.
VITE_STRIPE_PUBLISHABLE_KEY=__stripe_publishable_key__
STRIPE_SECRET_KEY=__stripe_secret_key__
STRIPE_WEBHOOK_SECRET=__stripe_webhook_signing_secret__

# ── Versanddienstleister / Label-Erstellung (optional) ──
SHIPPING_PROVIDER_API_KEY=__versanddienstleister_api_key__

# ── Web-Analyse (optional) ──
VITE_ANALYTICS_ID=__analytics_id__

# ── Stadtfest-Registrierungen (/stadtfest) ──
# Die Registrierungen liegen NICHT in der Website-Datenbank, sondern im
# Studio-Projekt (Tabelle stadtfest_registrierungen). Deshalb ein eigenes
# Paar Zugangsdaten. Der Service-Key bleibt serverseitig und darf nie
# VITE_ heissen, sonst landet er im Bundle.
# Fehlt eine der ersten drei Variablen, antwortet /api/stadtfest mit 503
# und das Formular sagt das ehrlich - es tut nicht so, als haette es
# gespeichert.
STADTFEST_SUPABASE_URL=__studio_supabase_url__
STADTFEST_SUPABASE_SERVICE_KEY=__studio_supabase_service_role_key__
STADTFEST_COMPANY_ID=__company_id_der_marke_videko__
# Salt fuer den IP-Hash der Rate-Begrenzung. Ohne Salt waere der Hash
# zurueckrechenbar; die IP selbst wird nie gespeichert.
STADTFEST_IP_SALT=__zufallszeichenkette__
# Notbremse: auf 0 setzen, dann nimmt das Formular nichts mehr entgegen.
# Leer oder nicht gesetzt heisst: schreiben erlaubt.
STADTFEST_SCHREIBEN=1

# ── Bierdeckel-Aktion (/terminal) ──
# Die Aktionsdaten liegen im Core-System videko-core-pilot, mit eigenem
# Variablenpaar – NICHT unter den SUPABASE_*-Werten oben (Projekt
# buchhaltung, dort bleiben Leads/Bestellungen). Zeigt TERMINAL_SUPABASE_URL
# auf buchhaltung, gilt das Terminal als nicht konfiguriert.
# Tabellen: supabase/migrations/*_terminal_*.sql.
# Fehlt TERMINAL_SUPABASE_URL, TERMINAL_SUPABASE_SERVICE_KEY oder
# TERMINAL_TOKEN_SECRET, antwortet /api/terminal mit 503 und die Seite sagt
# das ehrlich – sie tut nicht so, als hätte sie aktiviert.
TERMINAL_SUPABASE_URL=https://ewxvgzxifeuriukfqsld.supabase.co
TERMINAL_SUPABASE_SERVICE_KEY=__core_pilot_service_role_key__
#
# Die Lösung des Bierdeckel-Rätsels. Steht NUR hier: die Prüfung läuft
# serverseitig, damit der Code nicht im Browser-Bundle mitgeliefert wird.
# Groß-/Kleinschreibung und Leerzeichen sind egal.
TERMINAL_CODE=__loesung_des_raetsels__
# Schlüssel für die Signatur der Belege (Zugang + Sitzung, HMAC-SHA256).
# Lange Zufallszeichenkette. Wird er getauscht, müssen alle Teilnehmenden
# ihren Deckel-Code erneut eingeben – die Aktivierungen selbst bleiben.
TERMINAL_TOKEN_SECRET=__zufallszeichenkette_min_32_zeichen__
# Zugang zur Verwaltung /terminal/admin. Im Bundle steht kein Passwort; die
# Seite schickt diesen Wert als Kopfzeile, der Server vergleicht ihn.
# Fehlt er, ist /api/terminal-admin komplett zu (503) – kein Standardpasswort.
TERMINAL_ADMIN_TOKEN=__zufallszeichenkette_min_32_zeichen__
# Salt für den IP-Hash der Ratenbegrenzung. Ohne Salt wäre der Hash
# zurückrechenbar; die IP selbst wird nie gespeichert.
TERMINAL_IP_SALT=__zufallszeichenkette__
# Notbremse: auf 0 setzen, dann nimmt die Aktion keine Aktivierungen,
# Meldungen und Ziehungen mehr an. Leer oder nicht gesetzt heißt: erlaubt.
TERMINAL_SCHREIBEN=1

# ── Instagram-Follower-Sync (/terminal) ──
# Die Followerzahl von @videko.kuechen kommt stündlich aus der offiziellen
# Instagram Graph API (Feld followers_count) und landet in follower_zahl.
# Voraussetzung: @videko.kuechen ist ein Instagram Professional Account
# (Business oder Creator), verknüpft mit einer Facebook-Seite.
# NUR serverseitig – niemals mit VITE_-Präfix, sonst landet der Token im
# Browser-Bundle. Fehlen die Werte, bleibt die Handeingabe in der Verwaltung.
# Spalten anlegen mit supabase/terminal-instagram-schema.sql.
#
# Long-lived Access Token (läuft nach rund 60 Tagen ab und muss erneuert
# werden – die Verwaltung zeigt dann einen Fehler beim Sync).
INSTAGRAM_ACCESS_TOKEN=
# Numerische Instagram-Business-Account-ID (nicht der @-Name).
INSTAGRAM_USER_ID=
# Schützt /api/terminal-instagram. Vercel schickt ihn beim Cron-Aufruf als
# „Authorization: Bearer …". Fehlt er, ist der Endpoint zu (503).
CRON_SECRET=
