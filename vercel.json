{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",

  "trailingSlash": false,

  "redirects": [
    { "source": "/materialien", "destination": "/inspiration", "permanent": true },
    { "source": "/kontakt", "destination": "/beratung", "permanent": true },
    { "source": "/ueber-videko", "destination": "/ueber-uns", "permanent": true },
    { "source": "/kuechenwelten", "destination": "/stylefinder", "permanent": true },
    { "source": "/showroom", "destination": "/studio", "permanent": true }
  ]
}
